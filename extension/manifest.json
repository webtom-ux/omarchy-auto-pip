{
  "manifest_version": 3,
  "name": "Omarchy Auto PiP",
  "version": "1.0.3",
  "description": "Enter and exit HTML Picture-in-Picture for YouTube when Omarchy Auto PiP asks.",
  "key": "",
  "permissions": ["scripting", "tabs", "nativeMessaging"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*"
  ],
  "background": {
    "service_worker": "background-1.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
